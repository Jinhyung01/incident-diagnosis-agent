          "source_sha256": "a055571808051fed75963032c9417c1cf771e92fc98710685c12a6b85c206c7c",
          "snippet": "    def search(self, query, k=2):\n        self.build()\n        query_vector = self.embedder.embed([query])[0]\n        with sqlite3.connect(self.database) as db:\n            rows = db.execute(\"SELECT id,body,vector FROM documents\").fetchall()\n        ranked = []\n        for id, body, serialized in rows:\n            vector = json.loads(serialized)\n            if len(vector) != len(query_vector):\n                raise ValueError(\"Embedding dimension mismatch\")\n            score = sum(a * b for a, b in zip(query_vector, vector))",
          "code_lines": [
            {
              "number": 98,
              "text": "    def search(self, query, k=2):"
            },
            {
              "number": 99,
              "text": "        self.build()"
            },
            {
              "number": 100,
              "text": "        query_vector = self.embedder.embed([query])[0]"
            },
            {
              "number": 101,
              "text": "        with sqlite3.connect(self.database) as db:"
            },
            {
              "number": 102,
              "text": "            rows = db.execute(\"SELECT id,body,vector FROM documents\").fetchall()"
            },
            {
              "number": 103,
              "text": "        ranked = []"
            },
            {
              "number": 104,
              "text": "        for id, body, serialized in rows:"
            },
            {
              "number": 105,
              "text": "            vector = json.loads(serialized)"
            },
            {
              "number": 106,
              "text": "            if len(vector) != len(query_vector):"
            },
            {
              "number": 107,
              "text": "                raise ValueError(\"Embedding dimension mismatch\")"
            },
            {
              "number": 108,
              "text": "            score = sum(a * b for a, b in zip(query_vector, vector))"
            }
          ]
        }
      ],
