# 로컬 실행 기본 설정. 실제 .env와 SQLite DB는 Git에 올리지 않는다.
LLM_BACKEND=ollama
OLLAMA_FAST_MODEL=qwen3:0.6b
OLLAMA_QUALITY_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_PREDICT=512
LLM_CALL_TIMEOUT_SECONDS=25
REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=20
SIMULATE_FIRST_TIMEOUT=false
PROJECT_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=REPLACE_ME
LANGCHAIN_PROJECT=incident-diagnosis-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# PROJECT_TRACING=true로 설정한 경우에만 기존 LangSmith 추적을 활성화한다.
# 개선 버전은 Ollama를 검증했다. OpenAI 경로는 보존 원본에서만 제공한다.
