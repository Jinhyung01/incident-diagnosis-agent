# LangSmith를 사용할 때 이 파일을 .env로 복사하고 본인 키를 설정한다.
# 키 없이 로컬 모델만 실행하는 방법은 저장소 최상위 README.md를 참고한다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_ME
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OPENAI_API_KEY는 LLM_BACKEND=openai 모드에서만 필요하다.
# 실제 계정에 과금되므로 본인 키는 Git에서 제외된 .env에 설정한다.
OPENAI_API_KEY=REPLACE_ME
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
